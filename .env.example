# Copy this file to .env.local and fill in your Supabase project values.
# Find both values in: Supabase Dashboard → Project Settings → API

# The URL of your Supabase project (e.g. https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=your_supabase_project_url

# The public anon key (safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
